# Copiez ce fichier vers .env puis adaptez les valeurs.
# NE JAMAIS committer le fichier .env (il est dans .gitignore).

# paper = argent virtuel sur vraies cotes | live = ARGENT RÉEL (lisez le README)
MODE=paper

# momentum = achète la hausse | meanrev = achète les chutes
STRATEGY=momentum

# Mise par trade en USDC (banque virtuelle de 500 USDC)
STAKE_USDC=25

# Sortie de position : +10 % (take-profit) ou -10 % (stop-loss)
TAKE_PROFIT_PCT=10
STOP_LOSS_PCT=10

# Cycle du bot en secondes
POLL_SECONDS=60

# Nombre de marchés suivis (les plus actifs sur 24 h)
TOP_N=10

# Volume minimal sur 24 h pour qu'un marché soit éligible (évite les marchés illiquides)
MIN_VOLUME_24H=10000

# Fenêtre et seuil du signal de tendance
TREND_WINDOW=20
TREND_THRESHOLD_PCT=3

# ---- MODE LIVE UNIQUEMENT ----
# Clé privée du wallet Polygon dédié au bot. JAMAIS votre wallet principal.
# Ne mettez que quelques dizaines de dollars dessus.
PK=

# Doit être exactement YES pour autoriser le mode live
LIVE_CONFIRM=
